# ─── Database ───────────────────────────────────────────────────────────────
# MySQL connection string (Railway يوفرها تلقائياً عند إضافة MySQL plugin)
DATABASE_URL=mysql://user:password@host:3306/dbname

# ─── Auth ───────────────────────────────────────────────────────────────────
# مفتاح سري عشوائي لتشفير الجلسات (openssl rand -hex 32)
JWT_SECRET=change_me_to_a_random_secret_string

# ─── Admin Panel ────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password

# ─── Shopify ────────────────────────────────────────────────────────────────
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_ACCESS_TOKEN=your_storefront_token

# ─── App ────────────────────────────────────────────────────────────────────
# معرّف التطبيق (اختياري)
VITE_APP_ID=horizonline-tech-store

# ─── Analytics (اختياري) ────────────────────────────────────────────────────
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
